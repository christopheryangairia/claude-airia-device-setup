# Required — admin-level values for this Airia environment/organization.
MINT_API_KEY=""
GATEWAY_CONFIGURATION_ID=""

# Optional — override the defaults baked into the scripts (KEY_TYPE="User",
# ENABLED="true"). Uncomment and set only if your organization needs
# something other than the defaults. See README.md Section 1 for details.
# KEY_TYPE="User"
# ENABLED="true"

# Optional — User Impersonation / OAuth mode only. The user's Claude long-lived
# token (minted with `claude setup-token`). When set, the setup script offers it
# as the default (press Enter to confirm) instead of asking you to paste it.
# ANTHROPIC_LONG_LIVED_TOKEN="sk-ant-oat01-..."

# Optional — User Impersonation / OAuth mode only. How the user's token is
# provided: "helper" (Claude Desktop runs helpers/ and the user signs in once
# on first launch) or "static" (paste a token). Unset = ask, defaulting to
# helper, unless ANTHROPIC_LONG_LIVED_TOKEN is set. See README.md Section 7.
# CLAUDE_TOKEN_MODE="helper"
